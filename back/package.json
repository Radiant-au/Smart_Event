{
  "name": "back",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "nodemon",
    "test": "jest",
    "build": "rimraf dist && tsc",
    "seed:admin": "ts-node -r tsconfig-paths/register ./src/seeds/adminSeed.ts",
    "typeorm": "ts-node -r dotenv/config ./node_modules/typeorm/cli.js -d ./src/config/data-source.ts",
    "typeorm:run": "npm run typeorm -- migration:run",
    "typeorm:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create ./migrations",
    "typeorm:revert": "npm run typeorm -- migration:revert",
    "typeorm:generate": "npm run typeorm -- migration:generate src/migrations/migration",
    "typeorm:drop": "npm run typeorm -- schema:drop",
    "typeorm:sync": "npm run typeorm -- schema:sync",
    "typeorm:log": "npm run typeorm -- schema:log"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bwip-js": "^4.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.15.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
